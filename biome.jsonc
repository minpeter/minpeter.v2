{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/next",
    "ultracite/biome/react",
    "ultracite/biome/vitest"
  ],
  "files": {
    "includes": ["!public/fonts/*.css"]
  },
  "linter": {
    "rules": {
      "suspicious": {
        "useBaseline": {
          "level": "error",
          "options": {
            // @supports selector() cannot gate pseudo-elements for Biome; removing
            // these would change the visible text-selection and list-marker colors.
            "allowSelectors": ["selection", "marker"]
          }
        }
      }
    }
  }
}
